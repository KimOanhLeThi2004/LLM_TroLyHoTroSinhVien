###############################################################################
# Paperless-ngx settings                                                      #
###############################################################################

# See http://docs.paperless-ngx.com/configuration/ for all available options.

# The UID and GID of the user used to run paperless in the container. Set this
# to your UID and GID on the host so that you have write access to the
# consumption directory.
#USERMAP_UID=1000
#USERMAP_GID=1000

# See the documentation linked above for all options. A few commonly adjusted settings
# are provided below.

# This is required if you will be exposing Paperless-ngx on a public domain
# (if doing so please consider security measures such as reverse proxy)
#PAPERLESS_URL=https://paperless.example.com

# Required. A unique secret key for session tokens and signing.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=1IQ-0F_Ufqxf-ArC9tGMV2m_deIJcbwrQ4_PTROsirNFis2CbVcg8hA986lftj3ugWg7lOidOLrcPbTVYbkhkQ

# Use this variable to set a timezone for the Paperless Docker containers. Defaults to UTC.
#PAPERLESS_TIME_ZONE=America/Los_Angeles

# The default language to use for OCR. Set this to the language most of your
# documents are written in.
PAPERLESS_OCR_LANGUAGE=vie+eng

# Additional languages to install for text recognition, separated by a whitespace.
# Note that this is different from PAPERLESS_OCR_LANGUAGE (default=eng), which defines
# the language used for OCR.
# The container installs English, German, Italian, Spanish and French by default.
# See https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names
# for available languages.
PAPERLESS_OCR_LANGUAGES=vie

# Gemini OCR fallback settings
# Put your key here when running the local Docker stack.
PAPERLESS_GEMINI_API_KEY=AIzaSyAE4GrKnTJa4GZ9uBcuPMar1zQWh3Z9ol0
PAPERLESS_GEMINI_MODEL=gemini-2.5-flash
# PAPERLESS_GEMINI_MAX_INLINE_BYTES=20971520
PAPERLESS_GEMINI_TIMEOUT_SECONDS=300

# AI / chatbot settings
PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_MODEL=gemini-2.5-flash
PAPERLESS_AI_LLM_API_KEY=AIzaSyAE4GrKnTJa4GZ9uBcuPMar1zQWh3Z9ol0

# Qdrant settings. Keep both prefixes while merged code paths are being unified.
PAPERLESS_AI_QDRANT_URL=https://qdrant.daihoc.io.vn/collections
PAPERLESS_AI_QDRANT_API_KEY=qd-n8n-9F3KxP@2025
PAPERLESS_AI_QDRANT_COLLECTION=paperless-docs
PAPERLESS_QDRANT_URL=https://qdrant.daihoc.io.vn
PAPERLESS_QDRANT_API_KEY=qd-n8n-9F3KxP@2025

# Shared PostgreSQL database settings
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=daihoc.io.vn
PAPERLESS_DBPORT=5434
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=ppl
PAPERLESS_DBPASS=BlMH5YnBYZwsaf2wKdXyiSGBkafL0KVn
# PAPERLESS_DBSSLMODE=prefer
PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.100,192.168.100.145
PAPERLESS_CORS_ALLOWED_HOSTS=http://localhost:8000,http://192.168.100.100:8000,http://192.168.100.145:8000
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.100.100:8000,http://192.168.100.145:8000
